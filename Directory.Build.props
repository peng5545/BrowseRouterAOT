<Project>

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1031;CA1056;CA1054;CA1002</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <Version>0.1.0</Version>
    <Product>BrowseRouterAOT</Product>
    <Authors>BrowseRouterAOT</Authors>
    <Copyright>2026</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- LibraryImport source-generated P/Invoke uses internal unsafe pointer arithmetic. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IlcInstructionSet Condition="'$(RuntimeIdentifier)' == 'win-x64'">x86-64-v3</IlcInstructionSet>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Shared AOT compatibility, runtime-async & reflection-free JSON settings for all product projects. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'BrowseRouter.Tests'">
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!-- Shared NativeAOT WinExe settings for Host and Launcher. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'BrowseRouter.Host' or '$(MSBuildProjectName)' == 'BrowseRouter.Launcher'">
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <MetricsSupport>false</MetricsSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icon_res\icon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>