<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (GUI subsystem) so Windows doesn't briefly show a console window
         when the OS shell invokes us as a URL protocol handler. Main() still
         calls AttachConsole(ATTACH_PARENT_PROCESS) on entry, so help text
         printed to a parent terminal continues to work. -->
    <RootNamespace>BrowseRouter.Launcher</RootNamespace>
    <AssemblyName>BrowseRouter.Launcher</AssemblyName>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowseRouter.Core\BrowseRouter.Core.csproj" />
  </ItemGroup>

</Project>
